# Engine (laptop only; never needed by the Railway report server).
OPENROUTER_API_KEY=
KEENABLE_API_KEY=
# Keenable list price per search or fetch request, used for the Keenable cost columns (marked ~).
KEENABLE_USD_PER_REQUEST=0.004

# Report server.
# Directory holding audits/<slug>/results.json (default: audits).
AUDITS_DIR=audits
# 1 lists the synthetic audits/fixture report on the homepage (it is always reachable at /r/fixture).
SHOW_FIXTURE=0
